PORT=3000
NODE_ENV=development

# MongoDB Atlas — get free tier at mongodb.com/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/muse
MONGODB_URI=mongodb://localhost:27017/muse

# JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-very-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-very-long-random-string

# Gemini AI — get a key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=20000

# Legacy Groq vars are optional and no longer required
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TIMEOUT_MS=20000

# Email — free at resend.com (3000 emails/month)
# Leave blank to skip email verification in development
RESEND_API_KEY=re_...your_key_here
EMAIL_FROM=noreply@yourdomain.com
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=1

# Rate limits (per 15 min window)
RATE_LIMIT_ANALYZE=20
RATE_LIMIT_AUTH=10
RATE_LIMIT_GENERAL=200
